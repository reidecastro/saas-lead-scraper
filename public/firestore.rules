rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNÇÕES AUXILIARES DE SEGURANÇA
    // ==========================================

    // Verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se a requisição pertence ao próprio usuário
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verifica se o usuário autenticado possui a flag 'isAdmin: true' no seu documento de usuário
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ==========================================
    // COLEÇÃO: settings (Chaves API e Configurações de Planos)
    // ==========================================
    match /settings/{document} {
      // APENAS ADMINS podem ler ou alterar as chaves de API e valores de planos
      allow read, write: if isAdmin();
    }

    // ==========================================
    // COLEÇÃO: users (Perfis, Créditos e Planos)
    // ==========================================
    match /users/{userId} {
      // Qualquer usuário autenticado pode ler seu próprio perfil; Admins podem ler qualquer perfil
      allow read: if isOwner(userId) || isAdmin();

      // Criação de perfil ao se cadastrar (Plano Free inicial)
      allow create: if isOwner(userId) 
        && request.resource.data.isAdmin != true; // Impede que o usuário já se crie como admin

      // Atualização de perfil:
      // 1. Usuário comum só pode atualizar campos de perfil (ex: displayName), NUNCA créditos ou isAdmin.
      // 2. Admins podem atualizar qualquer campo (inclusive créditos e função).
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['credits', 'isAdmin', 'plan'])
      );

      // Apenas Admin pode deletar usuários
      allow delete: if isAdmin();

      // ------------------------------------------
      // SUBCOLEÇÃO: searches (Histórico de Buscas do Usuário)
      // ------------------------------------------
      match /searches/{searchId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // ------------------------------------------
      // SUBCOLEÇÃO: exports (Histórico de Exportações CSV/Excel)
      // ------------------------------------------
      match /exports/{exportId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ==========================================
    // COLEÇÃO: payments (Solicitações de Pix e Assinaturas)
    // ==========================================
    match /payments/{paymentId} {
      // Usuários autenticados podem ver apenas seus próprios pagamentos; Admins veem todos
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // O usuário pode criar um pedido de pagamento vinculado ao seu próprio UID (status obrigatoriamente 'pending')
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Apenas Admin pode alterar o status do pagamento (aprovar/recusar e creditar)
      allow update, delete: if isAdmin();
    }

  }
}